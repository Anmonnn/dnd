{
  "name": "dnd-world",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Интерактивная карта и энциклопедия D&D-мира",
  "scripts": {
    "dev": "npm run maps && vite",
    "dev:public": "npm run maps && vite --mode public",
    "build": "npm run maps && npm run check && vite build",
    "build:dm": "npm run maps && npm run check && vite build --mode dm",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name=dnd-world --branch=main --commit-dirty=true",
    "maps": "tsx tooling/maps/build-maps.ts",
    "maps:land": "tsx tooling/maps/extract-land.ts",
    "maps:inset": "tsx tooling/maps/make-inset.ts",
    "check": "tsx tooling/world/check.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "screenshot": "tsx tooling/dev/screenshot.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.2",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-contour": "^4.0.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.1.0",
    "playwright-core": "^1.63.0",
    "polygon-clipping": "^0.15.7",
    "polylabel": "^2.1.0",
    "sharp": "^0.35.5",
    "simplify-js": "^1.2.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
